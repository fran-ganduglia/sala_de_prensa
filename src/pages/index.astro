---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getNews, slugOf, formatTime } from '../lib/news';

const news = await getNews();
const main = news.find((entry) => entry.data.main) || news[0];
const featured = news.filter((entry) => entry.id !== main?.id).slice(0, 2);
const latest = [...news].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 5);
const sections = ['Política', 'Deportes', 'Cultura'];
---
<BaseLayout><Header /><main class="container"><section class="urgent-strip" aria-label="Noticias urgentes">{main?.data.urgent && <><span class="urgent-badge">URGENTE</span><a href={`/noticias/${slugOf(main)}/`}>{main.data.title}</a><span class="urgent-time">Actualizado</span></>}</section>{main && <section class="front-grid" id="actualidad"><article class="lead-story"><a class="story-image" style={`background-image:url('${main.data.image}')`} href={`/noticias/${slugOf(main)}/`}></a><div class="lead-content"><p class="eyebrow">{main.data.primarySection || 'ACTUALIDAD'}</p><h1><a href={`/noticias/${slugOf(main)}/`}>{main.data.title}</a></h1>{main.data.summary && <p class="lead-summary">{main.data.summary}</p>}<div class="story-meta"><time>{formatTime(main.data.publishedAt)}</time><span>•</span><a class="text-share" href={`/noticias/${slugOf(main)}/`}>Leer nota</a></div></div></article><div class="secondary-stories">{featured.map((entry) => <article class="story-card"><a class="card-image" style={`background-image:url('${entry.data.image}')`} href={`/noticias/${slugOf(entry)}/`}></a><p class="eyebrow">{entry.data.primarySection || 'ACTUALIDAD'}</p><h2><a href={`/noticias/${slugOf(entry)}/`}>{entry.data.title}</a></h2><time>{formatTime(entry.data.publishedAt)}</time></article>)}</div><aside class="latest-panel" id="ultimas"><div class="panel-title"><span></span><h2>Último momento</h2></div><ol>{latest.map((entry) => <li><time>{formatTime(entry.data.publishedAt)}</time><a href={`/noticias/${slugOf(entry)}/`}>{entry.data.title}</a></li>)}</ol><a class="all-latest" href="#archivo">Ver todas las noticias <span>→</span></a><aside class="ad ad-rail"><span>PUBLICIDAD</span><strong>Tu marca<br />puede estar acá</strong><small>Banner responsive</small></aside></aside></section>}</main><aside class="ad ad-horizontal container"><span>PUBLICIDAD</span><strong>Espacio publicitario</strong><small>Banner responsive</small></aside><main class="container">{sections.map((section, index) => { const entries = news.filter((entry) => entry.data.sections.includes(section)).slice(0, 3); return entries.length ? <section class="section-block" id={section.toLowerCase()}><div class="section-heading"><p class="section-index">0{index + 1}</p><h2>{section}</h2><a href={`/${section.toLowerCase()}/`}>Ver sección <span>→</span></a></div><div class="three-grid">{entries.map((entry) => <article class="story-card"><a class="card-image" style={`background-image:url('${entry.data.image}')`} href={`/noticias/${slugOf(entry)}/`}></a><p class="eyebrow">{entry.data.primarySection || section}</p><h3><a href={`/noticias/${slugOf(entry)}/`}>{entry.data.title}</a></h3><time>{formatTime(entry.data.publishedAt)}</time></article>)}</div></section> : null; })}</main><footer class="site-footer" id="contacto"><div class="container footer-grid"><div><img src="/assets/sala-de-prensa-logo.jpeg" alt="Sala de Prensa" class="footer-logo" /><p>Información, contexto y actualidad.<br />La voz del pueblo.</p></div><div><h2>Secciones</h2><a href="#actualidad">Actualidad</a><a href="#política">Política</a><a href="#deportes">Deportes</a><a href="#cultura">Cultura</a></div><div><h2>Contacto comercial</h2><p>¿Querés que tu marca llegue a nuestra comunidad?</p><a class="footer-cta" href="mailto:contacto@lanusaladeprensa.com">Publicitá con nosotros →</a></div></div><div class="footer-bottom container"><span>© 2026 Sala de Prensa</span><a href="/privacidad/">Política de privacidad</a></div></footer></BaseLayout>
