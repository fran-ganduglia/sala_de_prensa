---
import NewsArchive from '../../../components/NewsArchive.astro';
import Header from '../../../components/Header.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { archivePageCount, archivePageSize, getNews } from '../../../lib/news';

export async function getStaticPaths() {
  const news = await getNews();
  const pageCount = archivePageCount(news.length);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

const currentPage = Number(Astro.params.page);
const news = await getNews();
const pageCount = archivePageCount(news.length);
const entries = news.slice((currentPage - 1) * archivePageSize, currentPage * archivePageSize);
---

<BaseLayout title={`Archivo – página ${currentPage} | Sala de Prensa`} description={`Archivo de noticias, página ${currentPage}, de Sala de Prensa.`}>
  <Header />
  <main class="section-page container"><NewsArchive entries={entries} currentPage={currentPage} pageCount={pageCount} /></main>
</BaseLayout>
