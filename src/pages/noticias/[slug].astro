---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import FontecitaAd from '../../components/FontecitaAd.astro';
import { getNews, imagePosition, sectionHref, slugOf, formatDate, formatTime, type SiteSection } from '../../lib/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const entrySection = entry.data.primarySection as SiteSection;
const { Content } = await render(entry);
const related = (await getCollection('news')).filter((item) => item.id !== entry.id).slice(0, 2);
const editorial = (await getNews()).find((item) => item.data.featured && item.id !== entry.id);
const site = Astro.site || new URL('https://lanusaladeprensa.com/');
const articleUrl = new URL(Astro.url.pathname, site).href;
const articleImage = entry.data.image ? new URL(entry.data.image, site).href : undefined;
const publisherLogo = new URL('/assets/sala-de-prensa-logo-v2.png', site).href;
const organizationId = new URL('/#organization', site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  '@id': `${articleUrl}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  image: articleImage ? { '@type': 'ImageObject', url: articleImage, caption: entry.data.imageAlt || entry.data.title } : undefined,
  url: articleUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt || entry.data.publishedAt).toISOString(),
  articleSection: entrySection,
  keywords: entry.data.tags.length ? entry.data.tags.join(', ') : undefined,
  inLanguage: 'es-AR',
  isAccessibleForFree: true,
  author: { '@type': 'Organization', name: 'Sala de Prensa', url: site.href },
  publisher: { '@id': organizationId, '@type': 'NewsMediaOrganization', name: 'Sala de Prensa', logo: { '@type': 'ImageObject', url: publisherLogo } },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
    { '@type': 'ListItem', position: 2, name: entrySection, item: new URL(sectionHref(entrySection), site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: articleUrl },
  ],
};
const imageFrameStyle = (item: typeof entry) => `--image:url('${item.data.image}');--image-position:${imagePosition(item.data.imagePosition)}`;
---

<BaseLayout title={`${entry.data.title} | Sala de Prensa`} description={entry.data.summary} imageAlt={entry.data.imageAlt || entry.data.title} article={articleSchema} structuredData={[breadcrumbSchema]}>
  <Header active={entrySection} />
  <main id="nota" class="article-shell container">
    <div class="article-breadcrumb"><a href="/">Inicio</a><span>/</span><a href={sectionHref(entrySection)}>{entrySection}</a></div>
    <div class="article-layout">
      <article class="article-content">
        <div class="article-kicker"><span>{entrySection}</span>{entry.data.urgent && <span class="article-urgent">URGENTE</span>}</div>
        <h1>{entry.data.title}</h1>
        {entry.data.summary && <p class="article-deck">{entry.data.summary}</p>}
        <div class="article-info"><time>{formatDate(entry.data.publishedAt)} · {formatTime(entry.data.publishedAt)}</time>{entry.data.updatedAt && <span>Actualizada {formatDate(entry.data.updatedAt)}</span>}</div>
        <div class="article-actions">
          <span>Compartir</span>
          <button type="button" data-share>Compartir ↗</button>
          <a href={`https://wa.me/?text=${encodeURIComponent(`${entry.data.title}\n${articleUrl}`)}`} target="_blank" rel="noreferrer" aria-label="Compartir esta nota por WhatsApp">WhatsApp</a>
          <button type="button" data-copy-link>Copiar enlace</button>
        </div>
        {entry.data.image && <figure class="article-figure">
          <div class="article-image-frame image-frame" data-adaptive-image data-article-image style={imageFrameStyle(entry)}>
            <img src={entry.data.image} alt={entry.data.imageAlt || entry.data.title} fetchpriority="high" decoding="async" />
          </div>
          {entry.data.imageCredit && <figcaption>{entry.data.imageCredit}</figcaption>}
        </figure>}
        <div class="article-body"><Content /></div>
        {entry.data.gallery.length > 0 && <section class="article-gallery">
          <p class="eyebrow">GALERÍA</p>
          <div class="gallery-grid">{entry.data.gallery.map((item) => <figure><img src={item.image} alt={item.alt || item.caption || ''} loading="lazy" decoding="async" />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}</div>
        </section>}
        {entry.data.videos.map((video) => video.url && <section class="article-video"><a href={video.url} target="_blank" rel="noreferrer">Ver video: {video.caption || video.type} ↗</a></section>)}
        <aside class="ad ad-article"><span>PUBLICIDAD</span><strong>Espacio publicitario</strong></aside>
      </article>
      <aside class="article-aside">
        <div class="aside-latest"><p class="eyebrow">ÚLTIMO MOMENTO</p>{(await getNews()).slice(0, 3).map((item) => <a href={`/noticias/${slugOf(item)}/`}>{item.data.title}</a>)}</div>
        <FontecitaAd />
      </aside>
    </div>
    <section class="related-section">
      <div class="section-heading"><p class="section-index">SEGUIR LEYENDO</p><h2>También te puede interesar</h2></div>
      <div class="related-grid">
        {related.map((item) => <article>
          <a class="related-image image-frame" data-adaptive-image style={imageFrameStyle(item)} href={`/noticias/${slugOf(item)}/`}><img src={item.data.image} alt="" loading="lazy" decoding="async" /></a>
          <p class="eyebrow">AUTOMÁTICA</p>
          <h3><a href={`/noticias/${slugOf(item)}/`}>{item.data.title}</a></h3>
        </article>)}
        {editorial && <article class="editor-pick">
          <a class="related-image image-frame" data-adaptive-image style={imageFrameStyle(editorial)} href={`/noticias/${slugOf(editorial)}/`}><img src={editorial.data.image} alt="" loading="lazy" decoding="async" /></a>
          <p class="eyebrow">DESTACADA EN PORTADA</p>
          <h3><a href={`/noticias/${slugOf(editorial)}/`}>{editorial.data.title}</a></h3>
        </article>}
      </div>
    </section>
  </main>
</BaseLayout>
