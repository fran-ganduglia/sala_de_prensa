---
import { sectionHref, siteSections } from '../lib/news';
---

<footer class="site-footer" id="contacto">
  <div class="container footer-grid">
    <div>
      <picture><source srcset="/assets/sala-de-prensa-logo-v2.webp" type="image/webp" /><img src="/assets/sala-de-prensa-logo-v2.png" alt="Sala de Prensa" class="footer-logo" width="540" height="270" loading="lazy" decoding="async" /></picture>
      <p>Información, contexto y actualidad.<br />La voz del pueblo.</p>
    </div>
    <div>
      <h2>Secciones</h2>
      {siteSections.map((section) => <a href={sectionHref(section)}>{section}</a>)}
      <a href="/archivo/">Archivo</a>
    </div>
    <div>
      <h2>Contacto comercial</h2>
      <p>¿Querés que tu marca llegue a nuestra comunidad?</p>
      <a class="footer-cta" href="mailto:contacto@lanusaladeprensa.com">Publicitá con nosotros →</a>
    </div>
  </div>
  <div class="footer-bottom container">
    <span>© 2026 Sala de Prensa</span>
    <a href="/privacidad/">Política de privacidad</a>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>
