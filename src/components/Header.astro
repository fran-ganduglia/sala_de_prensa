---
import { sectionHref, siteSections } from '../lib/news';

const { active } = Astro.props;
---
<header class="site-header">
  <div class="utility-bar"><p>ACTUALIDAD · GBA</p><a href="#contacto">Publicitá con nosotros</a></div>
  <div class="brand-row container">
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <a class="brand" href="/"><picture><source srcset="/assets/sala-de-prensa-logo-v2.webp" type="image/webp" /><img src="/assets/sala-de-prensa-logo-v2.png" alt="Sala de Prensa, La voz del pueblo" width="540" height="270" fetchpriority="high" decoding="async" /></picture></a>
    <div class="header-tools"><div class="weather-slot" aria-live="polite"><span class="weather-kicker">CLIMA GBA</span><span class="weather-value" id="weather-value">Cargando clima…</span></div><a class="instagram-link" href="https://www.instagram.com/sala_de_prensa_ok/" aria-label="Seguir a Sala de Prensa en Instagram" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="instagram-dot" /></svg></a></div>
  </div>
  <nav class="main-nav" aria-label="Secciones"><div class="container nav-content">{siteSections.map((section) => <a class:list={{ active: section === active }} href={sectionHref(section)}>{section}</a>)}</div></nav>
</header>
<nav id="mobile-menu" class="mobile-menu" aria-label="Secciones móviles" hidden>{siteSections.map((section) => <a href={sectionHref(section)}>{section}</a>)}<a href="#contacto">Publicitá con nosotros</a></nav>
