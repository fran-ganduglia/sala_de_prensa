---
const { active = 'Actualidad' } = Astro.props;
const sections = ['Actualidad', 'Política', 'Deportes', 'Cultura'];
---
<header class="site-header"><div class="utility-bar"><p>ACTUALIDAD · GBA</p><a href="#contacto">Publicitá con nosotros</a></div><div class="brand-row container"><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button><a class="brand" href="/"><img src="/assets/sala-de-prensa-logo-v2.png" alt="Sala de Prensa, La voz del pueblo" /></a><div class="header-tools"><div class="weather-slot" aria-live="polite"><span class="weather-kicker">CLIMA GBA</span><span class="weather-value" id="weather-value">Cargando clima…</span></div><a class="instagram-link" href="https://www.instagram.com/sala_de_prensa_ok/" aria-label="Seguir a Sala de Prensa en Instagram" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="instagram-dot" /></svg></a></div></div><nav class="main-nav" aria-label="Secciones"><div class="container nav-content">{sections.map((section) => <a class:list={{ active: section === active }} href={`/#${section.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}`}>{section}</a>)}<a href="/#ultimas">Último momento</a></div></nav></header>
<div class="mobile-menu" aria-hidden="true">{sections.map((section) => <a href={`/#${section.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}`}>{section}</a>)}<a href="#contacto">Publicitá con nosotros</a></div>
