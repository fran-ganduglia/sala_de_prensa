---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`nv-ad ${className}`}>
  <span class="nv-ad-label">PUBLICIDAD</span>
  <div class="nv-banner">
    <div class="nv-top">
      <span class="nv-kicker">Complejo ecológico</span>
      <div class="nv-actions">
        <a href="https://naturalezaviva.com.ar/" target="_blank" rel="noopener noreferrer">Visitar sitio ↗</a>
        <a href="https://www.instagram.com/naturalezavivafnv?stkn=bDV2ODllcnQyY2dt" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      </div>
    </div>
    <div class="nv-main">
      <span class="nv-logo"><img src="/assets/naturaleza-viva-logo.png" alt="" width="575" height="230" decoding="async" /></span>
      <strong class="nv-title">Naturaleza Viva</strong>
    </div>
  </div>
</div>
