---
interface Props { placement: string; }
const { placement } = Astro.props;
---
<div class="sponsor-ad opj-ad" data-sponsor-name="OPJ" data-sponsor-placement={placement}>
  <span>PUBLICIDAD</span>
  <a href="https://ongopj.com.ar/" data-sponsor-link="imagen" target="_blank" rel="noopener noreferrer" aria-label="Visitar el sitio de Organización, Proyecto y Juventud">
    <img src="/assets/opj-logo.webp" alt="Organización, Proyecto y Juventud (OPJ)" width="637" height="640" loading="lazy" decoding="async" />
  </a>
</div>
